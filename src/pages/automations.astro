---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="AI & Workflow Automations | Resync Technology"
  description="Resync Technology builds custom AI and workflow automations for small businesses, including CRM sync, inbox routing, reporting, and back-office workflows."
>
  <header class="relative overflow-hidden border-b border-white/10 bg-[#070b17]">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -left-28 -top-32 h-96 w-96 rounded-full bg-red-500/25 blur-3xl"></div>
      <div class="absolute right-[-4rem] top-[-5rem] h-[28rem] w-[28rem] rounded-full bg-indigo-500/25 blur-3xl"></div>
      <div class="absolute inset-0 bg-[radial-gradient(120%_85%_at_18%_20%,rgba(225,29,72,0.24),transparent_48%),radial-gradient(120%_85%_at_85%_20%,rgba(56,189,248,0.18),transparent_52%),linear-gradient(180deg,rgba(10,14,28,0.9)_0%,rgba(7,10,20,0.98)_100%)]"></div>
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.22)_1px,transparent_1px)] bg-size-[11px_11px]"></div>
    </div>

    <section class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:py-24">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-white/70">Resync Technology</p>
        <h1 class="mt-4 max-w-xl text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">
          AI &amp; Workflow<br class="hidden sm:block" /> Automations
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-200/90 sm:text-lg">
          We design and build custom automations for small businesses across email, CRM, Google Workspace, and internal ops so your team spends less time on repetitive work.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/start" class="rt-btn-primary">
            Book a call
            <span class="cta-glow" aria-hidden="true"></span>
          </a>
          <a
            href="#example-automations"
            class="inline-flex items-center rounded-full border border-white/35 bg-white/90 px-4 py-2 text-sm font-medium text-slate-900 transition hover:bg-white"
          >
            See example automations
          </a>
        </div>
      </div>

      <aside class="relative overflow-hidden rounded-3xl border border-white/25 bg-white/12 p-6 text-white shadow-[0_30px_90px_rgba(2,8,23,0.55)] backdrop-blur" aria-label="Automation outcomes">
        <div class="absolute inset-0 bg-[radial-gradient(90%_70%_at_10%_0%,rgba(255,255,255,0.16),transparent_60%)]"></div>
        <div class="relative">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-white/70">Automation outcomes</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl border border-white/20 bg-white/12 p-3 text-white">
              <div class="flex items-start gap-2.5">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/25 bg-slate-900/80 text-white">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                </span>
                <div>
                  <p class="text-xs text-white/75">Lead response</p>
                  <p class="mt-1 text-sm font-semibold text-white">Faster handoff</p>
                </div>
              </div>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/12 p-3 text-white">
              <div class="flex items-start gap-2.5">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/25 bg-slate-900/80 text-white">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                </span>
                <div>
                  <p class="text-xs text-white/75">Data quality</p>
                  <p class="mt-1 text-sm font-semibold text-white">Fewer manual errors</p>
                </div>
              </div>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/12 p-3 text-white">
              <div class="flex items-start gap-2.5">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/25 bg-slate-900/80 text-white">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 18h16M7 14l3-3 3 2 4-5"/></svg>
                </span>
                <div>
                  <p class="text-xs text-white/75">Reporting</p>
                  <p class="mt-1 text-sm font-semibold text-white">Always up to date</p>
                </div>
              </div>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/12 p-3 text-white">
              <div class="flex items-start gap-2.5">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/25 bg-slate-900/80 text-white">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M5 19c1.5-3 4-4.5 7-4.5s5.5 1.5 7 4.5"/></svg>
                </span>
                <div>
                  <p class="text-xs text-white/75">Ops workload</p>
                  <p class="mt-1 text-sm font-semibold text-white">Less busywork</p>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-4 rounded-xl border border-white/25 bg-white/10 p-2">
            <div class="mb-2 flex items-center justify-between rounded-lg border border-white/20 bg-white/8 px-3 py-1.5">
              <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-white/70">Live automation preview</span>
              <span class="rounded-full border border-emerald-300/50 bg-emerald-300/15 px-2 py-0.5 text-[10px] font-semibold text-emerald-200">n8n</span>
            </div>
            <div class="image-ring overflow-hidden rounded-lg border border-white/20 bg-slate-900/90 p-2">
              <img
                src="auto.png"
                alt="n8n workflow canvas preview"
                loading="lazy"
                class="mx-auto w-full max-h-[22rem] object-contain"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-900/35 via-transparent to-transparent"></div>
              <div class="absolute bottom-5 left-6 flex items-center gap-2">
                <span class="rounded-full border border-white/30 bg-slate-900/70 px-2 py-0.5 text-[10px] font-semibold text-white">Webhook</span>
                <span class="rounded-full border border-white/30 bg-slate-900/70 px-2 py-0.5 text-[10px] font-semibold text-white">AI Step</span>
                <span class="rounded-full border border-white/30 bg-slate-900/70 px-2 py-0.5 text-[10px] font-semibold text-white">CRM Sync</span>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </section>
  </header>

  <section class="relative overflow-hidden bg-paper automation-surface" aria-labelledby="what-we-automate-heading">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute inset-0 bg-[radial-gradient(70%_80%_at_80%_20%,rgba(56,189,248,0.08),transparent_55%)]"></div>
      <div class="automation-aurora absolute inset-0 opacity-70"></div>
      <div class="automation-grid absolute inset-0 opacity-40"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-10 lg:py-24">
      <h2 id="what-we-automate-heading" class="text-3xl font-bold tracking-tight text-slate-900">What we automate</h2>
      <div class="automation-flow mt-6 hidden items-center justify-between rounded-2xl border border-slate-200/80 px-6 py-3.5 text-[12px] font-bold uppercase tracking-[0.16em] text-slate-500 shadow-soft md:flex lg:text-[13px]">
        <span>Trigger</span>
        <span class="flow-dot"></span>
        <span class="flow-line"></span>
        <span>Classify</span>
        <span class="flow-dot"></span>
        <span class="flow-line"></span>
        <span>Route</span>
        <span class="flow-dot"></span>
        <span class="flow-line"></span>
        <span>Confirm</span>
      </div>
      <div class="automation-flow-mobile mt-4 grid grid-cols-2 gap-2 rounded-2xl border border-slate-700/50 p-2 md:hidden">
        <span>Trigger</span>
        <span>Classify</span>
        <span>Route</span>
        <span>Confirm</span>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        <article class="automation-card group rounded-2xl border border-black/10 bg-white/85 p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-sky-200 hover:shadow-[0_22px_45px_rgba(14,165,233,0.12)]">
          <div class="liquid-chip" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 7h16M7 7v10m10-10v10M4 17h16M9 11h6" />
            </svg>
          </div>
          <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">01 • Intake</p>
          <h3 class="mt-4 text-base font-semibold text-slate-900">Lead &amp; CRM sync</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Move leads from forms, ads, and inboxes into your CRM with clean fields and instant handoff.
          </p>
        </article>

        <article class="automation-card group rounded-2xl border border-black/10 bg-white/85 p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-sky-200 hover:shadow-[0_22px_45px_rgba(14,165,233,0.12)]">
          <div class="liquid-chip" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 5h16v10H7l-3 3z" />
            </svg>
          </div>
          <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">02 • Triage</p>
          <h3 class="mt-4 text-base font-semibold text-slate-900">Inbox triage &amp; routing</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Classify incoming messages and route them to the right person, label, or workflow automatically.
          </p>
        </article>

        <article class="automation-card group rounded-2xl border border-black/10 bg-white/85 p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-sky-200 hover:shadow-[0_22px_45px_rgba(14,165,233,0.12)]">
          <div class="liquid-chip" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="11" width="3" height="7" />
              <rect x="10.5" y="8" width="3" height="10" />
              <rect x="17" y="5" width="3" height="13" />
            </svg>
          </div>
          <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">03 • Report</p>
          <h3 class="mt-4 text-base font-semibold text-slate-900">Reporting &amp; dashboards</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Consolidate data from multiple tools into daily summaries and dashboards your team can trust.
          </p>
        </article>

        <article class="automation-card group rounded-2xl border border-black/10 bg-white/85 p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-sky-200 hover:shadow-[0_22px_45px_rgba(14,165,233,0.12)]">
          <div class="liquid-chip" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16M4 12h16M4 18h16" />
              <circle cx="8" cy="6" r="1.5" fill="currentColor" stroke="none" />
              <circle cx="16" cy="12" r="1.5" fill="currentColor" stroke="none" />
              <circle cx="11" cy="18" r="1.5" fill="currentColor" stroke="none" />
            </svg>
          </div>
          <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">04 • Execute</p>
          <h3 class="mt-4 text-base font-semibold text-slate-900">Back-office workflows</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Automate billing updates, task creation, reminders, and follow-ups across your core systems.
          </p>
        </article>
      </div>
      <div class="mt-8 flex flex-col items-center justify-center gap-2">
        <a href="/start" class="liquid-metal-link" aria-label="Start your automation build">
          <span id="liquid-metal" class="liquid-metal">
            <span class="outline">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="svg-icon" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 18V6"></path>
                <path d="m7.5 10.5 4.5-4.5 4.5 4.5"></path>
              </svg>
            </span>
          </span>
        </a>
        <span class="liquid-metal-label">Automate</span>
      </div>
    </div>
  </section>

  <section id="example-automations" class="relative overflow-hidden border-y border-black/5 bg-[#f8fafc]" aria-labelledby="example-automations-heading">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute inset-0 bg-[radial-gradient(70%_75%_at_10%_15%,rgba(148,163,184,0.12),transparent_50%),radial-gradient(70%_70%_at_100%_50%,rgba(56,189,248,0.1),transparent_52%)]"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-14 sm:py-16 lg:py-20">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Blueprints</p>
          <h2 id="example-automations-heading" class="mt-2 text-3xl font-bold tracking-tight text-slate-900">PSD intake automation system</h2>
        </div>
        <div class="rounded-full border border-black/10 bg-white/80 px-4 py-2 text-xs font-medium text-slate-600">
          Inbox check interval: every 1 minute
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:gap-10">
        <div class="relative flex flex-col gap-3 sm:pl-2 lg:h-full lg:justify-between">
          <div class="pointer-events-none absolute bottom-3 left-6 top-3 hidden w-px bg-gradient-to-b from-red-200/80 via-slate-200 to-sky-200/80 sm:block"></div>

          <article class="group rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-soft transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-300 bg-slate-900 text-[11px] font-semibold text-white">01</div>
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex items-center justify-between gap-3">
                  <span class="rounded-full border border-slate-300 bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-700">Lead ops</span>
                  <span class="text-slate-300 transition group-hover:text-slate-500">→</span>
                </div>
                <p class="text-sm text-slate-700 sm:text-base">Watch the <span class="font-semibold text-slate-900">client intake inbox</span> and trigger on approved sender patterns.</p>
              </div>
            </div>
          </article>

          <article class="group rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-soft transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-300 bg-slate-900 text-[11px] font-semibold text-white">02</div>
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex items-center justify-between gap-3">
                  <span class="rounded-full border border-slate-300 bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-700">Intent AI</span>
                  <span class="text-slate-300 transition group-hover:text-slate-500">→</span>
                </div>
                <p class="text-sm text-slate-700 sm:text-base">Classify each message by category, urgency, and action needed (medical, cosmetic, insurance, spam, callback).</p>
              </div>
            </div>
          </article>

          <article class="group rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-soft transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-300 bg-slate-900 text-[11px] font-semibold text-white">03</div>
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex items-center justify-between gap-3">
                  <span class="rounded-full border border-slate-300 bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-700">JSON output</span>
                  <span class="text-slate-300 transition group-hover:text-slate-500">→</span>
                </div>
                <p class="text-sm text-slate-700 sm:text-base">Return structured output: <code>category</code>, <code>urgency_level</code>, <code>summary</code>, <code>action_needed</code>, <code>confidence_score</code>.</p>
              </div>
            </div>
          </article>

          <article class="group rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-soft transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-300 bg-slate-900 text-[11px] font-semibold text-white">04</div>
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex items-center justify-between gap-3">
                  <span class="rounded-full border border-slate-300 bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-700">Smart routing</span>
                  <span class="text-slate-300 transition group-hover:text-slate-500">→</span>
                </div>
                <p class="text-sm text-slate-700 sm:text-base">Route high-priority cases instantly and direct each category to the correct staff workflow.</p>
              </div>
            </div>
          </article>

          <article class="group rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-soft transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-300 bg-slate-900 text-[11px] font-semibold text-white">05</div>
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex items-center justify-between gap-3">
                  <span class="rounded-full border border-slate-300 bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-slate-700">Live alerts</span>
                  <span class="text-slate-300 transition group-hover:text-slate-500">→</span>
                </div>
                <p class="text-sm text-slate-700 sm:text-base">Post priority updates to the care team channel and log every handoff for follow-up visibility.</p>
              </div>
            </div>
          </article>
        </div>

        <aside class="relative h-full overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 p-5 text-slate-100 shadow-[0_25px_70px_rgba(15,23,42,0.28)] sm:p-6" aria-label="Example workflow diagram">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(90%_80%_at_20%_0%,rgba(30,41,59,0.9),transparent_55%),radial-gradient(90%_80%_at_80%_100%,rgba(15,23,42,0.9),transparent_55%)]"></div>
          <div class="relative">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">PSD workflow map</p>
            <div class="mt-4 space-y-3">
              <div class="rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm font-semibold text-slate-100">Incoming PSD inbox email</div>
              <div class="flex justify-center">
                <div class="inline-flex rounded-full border border-slate-600 bg-slate-800 px-3 py-1 text-xs text-slate-300">Gmail trigger</div>
              </div>
              <div class="text-center text-slate-500">↓</div>
              <div class="rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm font-semibold text-slate-100">AI classification + urgency scoring</div>
              <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2">
                <div class="h-px w-full bg-slate-700"></div>
                <span class="text-[11px] uppercase tracking-[0.12em] text-slate-500">route</span>
                <div class="h-px w-full bg-slate-700"></div>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                <div class="rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm font-semibold text-slate-100">Priority alert + callback queue</div>
                <div class="rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm font-semibold text-slate-100">Category-based staff routing</div>
              </div>
            </div>
            <div class="image-ring mt-5 overflow-hidden rounded-xl border border-slate-700">
              <img
                src="/psd-automation.jpg"
                alt="PSD automation workflow screenshot"
                loading="lazy"
                class="w-full h-auto object-contain"
              />
            </div>
          </div>
        </aside>
      </div>

      <article class="mt-10 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-[0_25px_80px_rgba(15,23,42,0.08)]">
        <div class="grid gap-0 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="p-6 sm:p-8">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-2xl font-bold tracking-tight text-slate-900">Featured automation: PSD Email Intake AI Routing</h3>
              <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-slate-600">Live client workflow</span>
            </div>
            <p class="text-sm leading-relaxed text-slate-700 sm:text-base">
              This automation monitors every new email, interprets intent with AI, and routes each message into the right handling lane before the inbox bottlenecks your staff.
            </p>
            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Current impact</p>
                <ul class="mt-2 space-y-1.5 text-sm text-slate-700">
                  <li>Less manual triage</li>
                  <li>Faster first response</li>
                  <li>Fewer missed urgent cases</li>
                </ul>
              </div>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Structured output</p>
                <ul class="mt-2 space-y-1.5 text-sm text-slate-700">
