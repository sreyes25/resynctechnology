---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "NYC Custom Software Development | Resync Technology";
const description =
  "Custom software development in NYC for businesses that need modern systems, workflow automation, and clean engineering delivery.";
const keywords = [
  "software development company nyc",
  "nyc custom software development",
  "custom software nyc",
  "developer hire nyc",
  "business automation nyc",
  "api integration nyc",
  "workflow automation nyc",
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Custom Software Development",
    areaServed: ["New York City", "Brooklyn"],
    provider: { "@type": "ProfessionalService", name: "Resync Technology LLC" },
    description,
  }}
>
  <section class="relative overflow-hidden bg-[#05060f] text-slate-100">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-24 top-0 h-72 w-72 rounded-full bg-resync-600/25 blur-3xl"></div>
      <div class="absolute right-0 top-10 h-80 w-80 rounded-full bg-[#0d172a] blur-[120px]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.06),transparent_30%),radial-gradient(circle_at_80%_0%,rgba(225,29,72,0.08),transparent_28%),radial-gradient(circle_at_50%_70%,rgba(255,255,255,0.05),transparent_38%)]"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-28 md:pb-24">
      <p class="hero-eyebrow">NYC custom software development</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-white md:text-6xl">
        Custom Software Built for NYC Business Operations
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-200/90">
        Resync Technology designs and builds custom software systems for New York City teams that need reliable execution,
        modern architecture, and automation-first workflows.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/start" class="rt-btn-primary">
          Start a Project
          <span class="cta-glow" aria-hidden="true"></span>
        </a>
        <a href="/services/websites" class="cta-secondary">Web Development NYC</a>
      </div>
    </div>
  </section>

  <section class="bg-paper text-slateink">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold text-slateink">What We Build</h2>
        <p class="mt-3 text-slate-700">
          We help NYC and Brooklyn companies modernize legacy systems, connect APIs, and ship software that supports day-to-day operations.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">Legacy System Modernization</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Upgrade brittle systems into maintainable platforms without disrupting business-critical workflows.</p>
        </article>
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">Workflow + CRM Automation</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Automate lead handling, follow-up, and internal operations to reduce manual work and increase speed.</p>
        </article>
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">API Integration</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Connect your existing tools into one clear system with reliable data flow and operational visibility.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
