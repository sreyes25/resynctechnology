---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Digital Marketing NYC | SEO + Performance Growth";
const description =
  "Digital marketing services in NYC for SEO, paid acquisition, and lifecycle optimization that generate qualified pipeline.";
const keywords = [
  "digital marketing nyc",
  "seo nyc",
  "technical seo nyc",
  "growth marketing nyc",
  "software marketing nyc",
  "business automation nyc",
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Digital Marketing",
    areaServed: ["New York City", "Brooklyn"],
    provider: { "@type": "ProfessionalService", name: "Resync Technology LLC" },
    description,
  }}
>
  <section class="relative overflow-hidden bg-[#05060f] text-slate-100">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-24 top-0 h-72 w-72 rounded-full bg-resync-600/25 blur-3xl"></div>
      <div class="absolute right-0 top-10 h-80 w-80 rounded-full bg-[#0d172a] blur-[120px]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.06),transparent_30%),radial-gradient(circle_at_80%_0%,rgba(225,29,72,0.08),transparent_28%),radial-gradient(circle_at_50%_70%,rgba(255,255,255,0.05),transparent_38%)]"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-28 md:pb-24">
      <p class="hero-eyebrow">Digital marketing NYC</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-white md:text-6xl">
        Growth Systems Built for Revenue, Not Vanity Metrics
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-200/90">
        We design digital marketing systems for NYC companies using technical SEO, paid acquisition, and lifecycle strategy that align directly to qualified pipeline growth.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/start" class="rt-btn-primary">
          Start a Growth Project
          <span class="cta-glow" aria-hidden="true"></span>
        </a>
        <a href="/services/digital-marketing" class="cta-secondary">Core Digital Marketing Service</a>
      </div>
    </div>
  </section>

  <section class="bg-paper text-slateink">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold text-slateink">Execution Model</h2>
        <p class="mt-3 text-slate-700">
          Build full-funnel visibility across SEO, paid campaigns, and conversion operations with consistent performance tracking.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">Technical SEO</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Strengthen crawlability, content architecture, and on-page structure for competitive NYC search intent.</p>
        </article>
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">Paid Acquisition</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Run disciplined search and social campaigns focused on qualified leads and efficient spend.</p>
        </article>
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">Lifecycle Optimization</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Improve follow-up speed and conversion rates through CRM and marketing automation systems.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
