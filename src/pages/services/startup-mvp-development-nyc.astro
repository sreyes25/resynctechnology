---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Startup MVP Development NYC | Resync Technology";
const description =
  "Startup MVP development in NYC for founders who need a fast launch, clean architecture, and a roadmap to scale.";
const keywords = [
  "startup mvp development nyc",
  "mvp development nyc",
  "saas development nyc",
  "app development nyc startup",
  "custom software nyc startup",
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Startup MVP Development",
    areaServed: ["New York City", "Brooklyn"],
    provider: { "@type": "ProfessionalService", name: "Resync Technology LLC" },
    description,
  }}
>
  <section class="relative overflow-hidden bg-[#05060f] text-slate-100">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-24 top-0 h-72 w-72 rounded-full bg-resync-600/25 blur-3xl"></div>
      <div class="absolute right-0 top-10 h-80 w-80 rounded-full bg-[#0d172a] blur-[120px]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.06),transparent_30%),radial-gradient(circle_at_80%_0%,rgba(225,29,72,0.08),transparent_28%),radial-gradient(circle_at_50%_70%,rgba(255,255,255,0.05),transparent_38%)]"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-28 md:pb-24">
      <p class="hero-eyebrow">Startup MVP development NYC</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-white md:text-6xl">
        Launch a Reliable MVP Without Overbuilding
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-200/90">
        We help NYC founders ship focused MVP products with production-quality architecture, fast iteration loops, and a clear path to scale into SaaS.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/start" class="rt-btn-primary">
          Start an MVP Project
          <span class="cta-glow" aria-hidden="true"></span>
        </a>
        <a href="/services/nyc-custom-software-development" class="cta-secondary">NYC Custom Software</a>
      </div>
    </div>
  </section>

  <section class="bg-paper text-slateink">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold text-slateink">MVP Build Framework</h2>
        <p class="mt-3 text-slate-700">
          Build only what validates demand first, then scale with confidence using structured engineering milestones.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">Discovery + Scope</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Define the smallest launchable product with clear user outcomes and measurable targets.</p>
        </article>
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">Build + Validate</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Release quickly, gather feedback, and prioritize high-impact improvements with tight iterations.</p>
        </article>
        <article class="rounded-xl2 border border-black/10 bg-white p-6 shadow-soft">
          <h3 class="text-lg font-semibold text-slateink">Scale to SaaS</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Stabilize architecture, add automations, and expand the product roadmap based on real usage data.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
