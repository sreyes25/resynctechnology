---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import WhyResync from "../components/WhyResync.astro";
import Work from "../components/Work.astro";
import CTA from "../components/CTA.astro";
import SeoFaq from "../components/SeoFaq.astro";

const title = "Software Development Company NYC | Resync Technology";
const description =
  "Resync is a NYC software studio building custom software, web development, app development, and business automation systems for growing teams.";
const keywords = [
  "software development company nyc",
  "custom software nyc",
  "web development nyc",
  "app development nyc",
  "business automation nyc",
  "digital marketing nyc",
  "brooklyn software developer",
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How much does custom software development cost in NYC?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Pricing depends on scope, integrations, and delivery timeline. Most projects are phased so teams can launch core workflows first.",
        },
      },
      {
        "@type": "Question",
        name: "Do you build websites and apps in Brooklyn and NYC?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Resync builds websites, apps, and custom software for businesses across Brooklyn and New York City.",
        },
      },
    ],
  }}
>
  <Hero />
  <Services />
  <Process />
  <WhyResync />
  <Work />
  <SeoFaq />
  <CTA />
</BaseLayout>
