---
const primaryCta = "/start";
const secondaryCta = "/#services";
---

<section class="hero-wrap">
  <!-- Layered background -->
  <div class="hero-bg"></div>

  <!-- Layered glows -->
  <div class="hero-overlay hero-overlay-top"></div>
  <div class="hero-overlay hero-overlay-bottom"></div>
  <div class="hero-overlay hero-overlay-warm"></div>
  <div class="hero-overlay hero-overlay-left"></div>

  <div class="hero-shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">Resync Your Technology</p>
        <h1 class="hero-title">
         Building <span class="highlight shimmer">AI-Powered</span><br class="hidden sm:block" />
         Apps, Agents,<br class="hidden sm:block" />
         and Platforms
        </h1>
        <p class="hero-sub">
          At Resync Technology, we help businesses modernize, integrate, and build custom software that fits the way you operate.
        </p>

        <div class="hero-logos">
          <p class="hero-logos-label">Building Modern Technology</p>
          <div class="hero-logos-row">
            <span class="hero-logo-item">
              <img src="/services/app.svg" alt="" class="hero-logo-icon" loading="lazy" />
              Apps
            </span>
            <span class="hero-logo-item">
              <img src="/services/web.svg" alt="" class="hero-logo-icon" loading="lazy" />
              Websites
            </span>
            <span class="hero-logo-item">
              <img src="/services/automate.svg" alt="" class="hero-logo-icon" loading="lazy" />
              Automation
            </span>
          </div>
        </div>

        <div class="hero-ctas">
          <a href={primaryCta} class="rt-btn-primary">
            <span class="cta-glow"></span>
            Resync Project
          </a>
          <a href={secondaryCta} class="cta-secondary">
            Explore our services <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
  <div class="hero-visual">
    <div class="stack-container" aria-label="Rotating feature cards">
      <div class="glass-card" data-pos="1" aria-label="Discovery card">
        <div class="card-header">
          <span>Discovery</span>
        </div>
        <div class="card-content hud-card">
          <div class="hud-visual card-visual hud-visual-discovery" aria-hidden="true">
            <span class="hud-lens"></span>
            <div class="hud-map-route">
              <svg class="hud-map-svg" viewBox="0 0 300 92" preserveAspectRatio="none" aria-hidden="true">
                <polyline class="hud-map-line" points="18,66 84,42 146,62 214,28 282,44"></polyline>
              </svg>
              <span class="hud-path-dot d1"></span>
              <span class="hud-path-dot d2"></span>
              <span class="hud-path-dot d3"></span>
              <span class="hud-path-dot d4"></span>
              <span class="hud-path-dot d5"></span>
              <span class="hud-route-pulse"></span>
            </div>
          </div>
          <div class="hud-copy">
            <p class="hud-title">Discovery</p>
            <p class="hud-subline">We map out exactly what your business needs.</p>
          </div>
        </div>
      </div>

      <div class="glass-card" data-pos="2" aria-label="Tailored solutions card">
        <div class="card-header">
          <span>Tailored Solutions</span>
        </div>
        <div class="card-content hud-card">
          <div class="hud-visual card-visual hud-visual-tailored" aria-hidden="true">
            <span class="hud-grid-frame"></span>
            <div class="hud-tailored-stack">
              <div class="hud-screen web">
                <span class="screen-top"></span>
                <span class="desktop-dots"></span>
                <img src="/services/web.svg" alt="" class="screen-icon" loading="lazy" />
                <span class="screen-line l1"></span>
                <span class="screen-line l2"></span>
                <span class="screen-title">Website</span>
              </div>
              <div class="hud-screen app">
                <span class="phone-notch"></span>
                <img src="/services/app.svg" alt="" class="screen-icon" loading="lazy" />
                <span class="phone-home"></span>
                <span class="screen-title">App</span>
              </div>
              <div class="hud-screen marketing">
                <div class="post-head">
                  <span class="post-avatar"></span>
                  <span class="post-user">Resync</span>
                  <span class="post-menu" aria-hidden="true">•••</span>
                </div>
                <div class="post-media">
                  <img src="/services/consultation.svg" alt="" class="post-media-icon" loading="lazy" />
                  <span class="post-media-title">MARKETING</span>
                </div>
                <div class="post-actions">
                  <span class="action-btn heart" aria-hidden="true"></span>
                  <span class="action-btn comment" aria-hidden="true"></span>
                  <span class="action-btn share" aria-hidden="true"></span>
                  <span class="action-btn save" aria-hidden="true"></span>
                </div>
              </div>
            </div>
          </div>
          <div class="hud-copy">
            <p class="hud-title">Tailored Solutions</p>
            <p class="hud-subline">Custom-built software that fits how you operate.</p>
          </div>
        </div>
      </div>

      <div class="glass-card" data-pos="3" aria-label="Seamless integration card">
        <div class="card-header">
          <span>Seamless Integration</span>
        </div>
        <div class="card-content hud-card">
          <div class="hud-visual card-visual hud-visual-integration" aria-hidden="true">
            <div class="hud-int-head">
              <span class="hud-int-title">One smooth workflow</span>
              <span class="hud-int-badge">Live sync</span>
            </div>

            <div class="hud-int-lane">
              <div class="hud-int-step">
                <span class="hud-int-step-title">New Lead</span>
                <span class="hud-int-step-sub">Website form submitted</span>
              </div>
              <span class="hud-int-connector"></span>
              <div class="hud-int-step">
                <span class="hud-int-step-title">CRM Updated</span>
                <span class="hud-int-step-sub">Contact + notes saved</span>
              </div>
              <span class="hud-int-connector"></span>
              <div class="hud-int-step">
                <span class="hud-int-step-title">Follow-up Sent</span>
                <span class="hud-int-step-sub">Email + text confirmation</span>
              </div>
              <span class="hud-int-connector"></span>
              <div class="hud-int-step">
                <span class="hud-int-step-title">Call Booked</span>
                <span class="hud-int-step-sub">Calendar updated automatically</span>
              </div>
            </div>

            <div class="hud-int-foot">
              <span>No manual copying between tools.</span>
              <span>Less delay, fewer mistakes.</span>
            </div>
          </div>
          <div class="hud-copy">
            <p class="hud-title">Seamless Integration</p>
            <p class="hud-subline">All your systems connected into one smooth workflow.</p>
          </div>
        </div>
      </div>

      <div class="glass-card" data-pos="4" aria-label="Growth and impact card">
        <div class="card-header">
          <span>Growth &amp; Impact</span>
        </div>
        <div class="card-content hud-card">
          <div class="hud-visual card-visual hud-visual-growth" aria-hidden="true">
            <span class="hud-chart-frame"></span>
            <span class="hud-chart-grid"></span>
            <svg class="hud-trend-svg" viewBox="0 0 320 110" preserveAspectRatio="none">
              <path class="hud-trend-area" d="M0 90 L45 76 L90 84 L135 64 L180 72 L225 50 L270 58 L320 30 L320 110 L0 110 Z"></path>
              <polyline class="hud-trend-stroke" points="0,90 45,76 90,84 135,64 180,72 225,50 270,58 320,30"></polyline>
              <circle class="hud-trend-dot d1" cx="45" cy="76" r="3.2"></circle>
              <circle class="hud-trend-dot d2" cx="90" cy="84" r="3.2"></circle>
              <circle class="hud-trend-dot d3" cx="135" cy="64" r="3.2"></circle>
              <circle class="hud-trend-dot d4" cx="180" cy="72" r="3.2"></circle>
              <circle class="hud-trend-dot d5" cx="225" cy="50" r="3.2"></circle>
              <circle class="hud-trend-dot d6" cx="270" cy="58" r="3.2"></circle>
            </svg>
          </div>
          <div class="hud-copy">
            <p class="hud-title">Growth &amp; Impact</p>
            <p class="hud-subline">See clearer results, faster and more predictable.</p>
          </div>
        </div>
      </div>
    </div>
  </div>


    </div>
  </div>
</section>

<style>
  .hero-wrap{
    position: relative;
    overflow: hidden;
    color: white;
    min-height: min(45vh, 1100px);
    background: linear-gradient(180deg, rgb(34 0 7) 0%, rgb(136 0 26 / 51%) 5%, rgba(58, 12, 22, 0.9) 20%, rgba(20, 10, 14, 0.8) 56%, rgba(6, 3, 5, 0.92) 92%, rgba(3, 2, 4, 0.98) 100%);
    padding-top: calc(var(--rt-nav-offset) + 1.9%);
  }
  .hero-bg{
    position: absolute;
    inset: -3% -2% -6%;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(circle at 24% 24%, #ff0011, rgb(0, 0, 0)),
      radial-gradient(circle at 78% 20%, #ff7a5a42, rgba(0,0,0,0)),
      radial-gradient(120% 120% at 50% 102%, rgba(32, 12, 16, 0.65), rgba(4,3,5,0.95)),
      linear-gradient(180deg, #1c0c12 0%, #0f070b 32%, #080509 58%, #040305 100%);
    filter: saturate(1.05);
  }
  .hero-bg::after{
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgba(255, 0, 0, 0.04) 1px, transparent 1px),
      linear-gradient(0deg, rgba(255,120,120,0.04) 1px, transparent 1px),
      radial-gradient(circle at 50% 96%, rgba(255, 64, 64, 0.16), rgba(0,0,0,0));
    background-size: 140px 140px, 140px 140px, cover;
    mix-blend-mode: soft-light;
    opacity: 0.5;
  }
  .hero-overlay{
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .hero-overlay-top{
    background: linear-gradient(180deg, rgb(255, 0, 17), rgba(0, 0, 0, 0.48));
  }
  .hero-overlay-bottom{
    background:
      radial-gradient(140% 120% at 50% 0%, rgba(26, 10, 15, 0.95), transparent 36%, rgba(0,0,0,0.86)),
      linear-gradient(180deg, rgba(4,3,5,0) 0%, rgba(4,3,5,0.72) 60%, rgba(3,2,4,0.94) 100%);
    mask-image: linear-gradient(0deg, rgba(0,0,0,1), rgba(0,0,0,0.08));
  }
  .hero-overlay-radial{
    background: radial-gradient(circle at 30% 32%, rgba(255, 1, 39, 0.24), rgba(0,0,0,0));
  }
  .hero-overlay-warm{
    background: radial-gradient(circle at 1050% 2%, #ff0011, rgba(255, 0, 0, 0.072));
  }
  .hero-overlay-left{
    background: linear-gradient(90deg, rgba(0,0,0,0.7), rgba(0,0,0,0.05));
    mask-image: linear-gradient(90deg, rgba(0,0,0,0.85), rgba(0,0,0,0));
  }

  .hero-shell{
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: 0 auto;
    /* NOTE: middle clamp was reversed and was forcing large padding */
    padding: clamp(0rem, 0vw, 0rem) clamp(1rem, 4vw, 3.2rem) clamp(2rem, 8vw, 3.5rem);
  }

  @media (max-width: 639px){
    .hero-shell{
      padding: clamp(1rem, 4vw, 2rem) clamp(1.5rem, 6vw, 2rem) clamp(1.5rem, 8vw, 3rem);
    }
  }

  .hero-grid{
    display: grid;
    grid-template-columns: 2fr;
    gap: clamp(2rem, 6vw, 3rem);
    align-items: center;
  }

  .hero-copy{
    max-width: 640px;
  }
  .hero-title{
    margin-top: clamp(0.75rem, 2vw, 1.4rem);
    font-size: clamp(2.6rem, 5vw, 3.9rem);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-shadow: 0 12px 30px rgba(0,0,0,0.35);
  }
  .hero-sub{
    margin-top: 1rem;
    max-width: 560px;
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: rgba(255,255,255,0.75);
    line-height: 1.6;
  }

  .hero-logos{
    margin-top: clamp(1.6rem, 3vw, 2rem);
  }
  .hero-logos-label{
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.6);
  }
  .hero-logos-row{
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.2rem, 3vw, 2rem);
    align-items: center;
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255,255,255,0.82);
  }
  .hero-logo-item{
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .hero-logo-icon{
    width: 20px;
    height: 20px;
  }

  .hero-ctas{
    margin-top: clamp(1.8rem, 3vw, 2.2rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero-visual{
  position: relative;
  width: min(680px, 92vw);
  justify-self: center;
  aspect-ratio: 1;
  filter: drop-shadow(0 20px 40px rgba(0,0,0,0.65));
}
  .hero-visual-glow{
    position: absolute;
    inset: -12%;
    background: radial-gradient(circle, rgba(150,255,255,0.12), rgba(0,0,0,0));
    filter: blur(14px);
    z-index: 0;
  }
  .hero-visual-circle{
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.14);
    opacity: 0.6;
    z-index: 1;
  }
  .hero-visual-img{
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .highlight {
  position: relative;
  color: #f59e0b;
  font-weight: 700;
  /* This creates a warm, sun-like glow around the letters */
  text-shadow: 0 0 10px rgba(245, 158, 11, 0.4),
               0 0 20px rgba(245, 158, 11, 0.2);

  /* Optional: adds a tiny bit of extra spacing for readability */
  letter-spacing: 0.02em;
}
.shimmer {
  background: linear-gradient(
    90deg,
    rgba(245,158,11,0.85) 0%,
    rgba(255,249,230,0.95) 50%,
    rgba(245,158,11,0.85) 100%
  );
  background-size: 220% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shine 5s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  .shimmer {
    animation: none;
    background-position: 50% center;
  }
}

@keyframes shine {
  to {
    background-position: 200% center;
  }
}

  @media (min-width: 1024px){
    .hero-grid{
      /* give the copy more room like the reference */
      grid-template-columns: 1.95fr 1.05fr;
      gap: 1.75rem;
    }
    .hero-visual{
      width: 660px;
      margin-left: auto;
    }
  }

  @media (max-width: 639px){
    .hero-wrap{
      min-height: auto;
      padding-bottom: 1rem;
    }
    .hero-logos-row{
      gap: 1.4rem;
      flex-wrap: wrap;
    }
    .hero-ctas{
      flex-direction: column;
      align-items: stretch;
    }
    .rt-btn-primary,
    .cta-secondary{
      width: 100%;
      justify-content: center;
    }
    .hero-visual{
      width: min(340px, 80vw);
      margin-top: 0.5rem;
    }
  }

  .stack-container{
    position: relative;
    height: 520px;
    width: 100%;
    display: grid;
    place-items: center;
    perspective: 1700px;
    transform-style: preserve-3d;

    /* match reference: pushed right, slightly down */
    transform: translate3d(48px, -6px, 0);
  }

  .glass-card{
    position: absolute;

    /* card sizing */
    width: min(520px, 100%);
    aspect-ratio: 1.62 / 1;
    padding: 20px 22px 22px;
    border-radius: 22px;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;

/* darker glass + purple/magenta tint for readability */

    /* darker glass + purple/magenta tint for readability */
    background:
      radial-gradient(120% 140% at 18% 18%,
        rgba(255,255,255,0.14),
        rgba(255,255,255,0.05) 38%,
        rgba(0,0,0,0.42) 100%),
      radial-gradient(90% 80% at 82% 12%,
        rgba(124,58,237,0.30),
        rgba(0,0,0,0) 62%),
      radial-gradient(80% 90% at 20% 88%,
        rgba(236,72,153,0.18),
        rgba(0,0,0,0) 60%),
      linear-gradient(180deg,
        rgba(20, 13, 24, 0.66) 0%,
        rgba(13, 10, 18, 0.74) 58%,
        rgba(7, 6, 11, 0.92) 100%);

    border: 1px solid rgba(255,255,255,0.16);
    backdrop-filter: blur(22px) saturate(1.2);
    -webkit-backdrop-filter: blur(22px) saturate(1.2);

    box-shadow:
      0 28px 92px rgba(0,0,0,0.62),
      inset 0 1px 0 rgba(255,255,255,0.10);

    transform-style: preserve-3d;

    /* default for back cards */
    transform: translate3d(0,0,0);
    opacity: 0.35;
    filter: blur(0.45px) saturate(1.08);
    will-change: transform, opacity, filter;

    transition:
      transform 850ms cubic-bezier(0.2, 0.85, 0.2, 1),
      opacity 850ms cubic-bezier(0.2, 0.85, 0.2, 1),
      filter 850ms cubic-bezier(0.2, 0.85, 0.2, 1),
      box-shadow 850ms cubic-bezier(0.2, 0.85, 0.2, 1),
      border-color 850ms cubic-bezier(0.2, 0.85, 0.2, 1);
  }



  .glass-card::before{
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(120deg, rgba(255,255,255,0.22), rgba(255,255,255,0) 42%),
      radial-gradient(85% 75% at 78% 14%, rgba(168,85,247,0.28), rgba(0,0,0,0) 62%),
      radial-gradient(80% 70% at 18% 92%, rgba(244,63,94,0.14), rgba(0,0,0,0) 60%);
    opacity: 0.18;
    pointer-events: none;
  }

  .glass-card::after{
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
    opacity: 1;
    pointer-events: none;
  }

  /* 4-step 3D carousel positions (one card presented at a time) */
  .glass-card[data-pos="1"]{
    z-index: 4;
    opacity: 1;
    filter: blur(0px) saturate(1.12);
    transform: translate3d(0px, 34px, 210px) rotateX(2deg) rotateY(-10deg) scale(1);
    border-color: rgba(255,255,255,0.22);
    box-shadow:
      0 30px 96px rgba(0,0,0,0.68),
      0 0 0 1px rgba(168,85,247,0.18) inset,
      inset 0 1px 0 rgba(255,255,255,0.14);
  }
  .glass-card[data-pos="1"]::before{
    opacity: 0.24;
  }

  .glass-card[data-pos="2"]{
    z-index: 3;
    opacity: 0.86;
    filter: blur(0.08px) saturate(1.10);
    transform: translate3d(132px, -78px, 120px) rotateX(10deg) rotateY(-10deg) scale(0.95);
  }

  .glass-card[data-pos="3"]{
    z-index: 2;
    opacity: 0.62;
    filter: blur(0.22px) saturate(1.08);
    transform: translate3d(158px, 64px, 48px) rotateX(12deg) rotateY(-10deg) scale(0.91);
  }

  .glass-card[data-pos="4"]{
    z-index: 1;
    opacity: 0.42;
    filter: blur(0.55px) saturate(1.06);
    transform: translate3d(18px, -44px, -10px) rotateX(18deg) rotateY(-10deg) scale(0.87);
  }

  .mini-graph{
    position: relative;
    height: 112px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(0,0,0,0.18);
    border: 1px solid rgba(255,255,255,0.10);
  }
  .mini-graph-grid{
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgba(255,255,255,0.07) 1px, transparent 1px),
      linear-gradient(0deg, rgba(255,255,255,0.07) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.7;
  }
  .mini-graph-line{
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 14px;
    height: 46px;
    border-radius: 14px;
    background:
      radial-gradient(80% 120% at 20% 80%, rgba(34,197,94,0.55), rgba(0,0,0,0)),
      linear-gradient(135deg, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 40%, rgba(255,255,255,0.07) 100%);
    clip-path: polygon(0% 95%, 18% 82%, 34% 88%, 52% 66%, 70% 58%, 86% 40%, 100% 28%, 100% 100%, 0% 100%);
  }

  .card-header{
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.78);
    font-weight: 700;
    text-shadow: 0 2px 10px rgba(0,0,0,0.45);
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.12);
    padding-bottom: 8px;
  }

  .workflow{
    display: grid;
    gap: 10px;
  }
  .wf-node{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 12px;
    border-radius: 12px;
    background: rgba(0,0,0,0.34);
    border: 1px solid rgba(255,255,255,0.14);
    color: rgba(255,255,255,0.9);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 10px rgba(0,0,0,0.55);
  }
  .wf-node.small{
    height: 30px;
    padding: 0 10px;
    font-weight: 750;
    font-size: 11px;
    opacity: 0.92;
  }
  .wf-arrow{
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(168,85,247,0.0), rgba(168,85,247,0.45), rgba(34,197,94,0.35));
    position: relative;
    overflow: hidden;
  }
  .wf-arrow::after{
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.22), rgba(0,0,0,0));
