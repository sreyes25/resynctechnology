<script>
  (function () {
    const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const container = document.querySelector('.stack-container');
    if (!container) return;

    const cards = Array.from(container.querySelectorAll('.glass-card'));
    if (cards.length < 4) return;

    let timer = null;
    const intervalMs = 3600;

    function step() {
      cards.forEach((card) => {
        const pos = Number(card.dataset.pos || '1');
        // 1(front) -> 4(farthest), 2 -> 1, 3 -> 2, 4 -> 3
        const next = pos === 1 ? 4 : (pos - 1);
        card.dataset.pos = String(next);
      });
    }

    function start() {
      if (timer) return;
      timer = window.setInterval(step, intervalMs);
    }

    function stop() {
      if (!timer) return;
      window.clearInterval(timer);
      timer = null;
    }

    function resetCardFx() {
      cards.forEach((card) => {
        card.style.setProperty('--mx', '50%');
        card.style.setProperty('--my', '50%');
        const content = card.querySelector('.card-content');
        if (!content) return;
        content.style.setProperty('--tx', '0px');
        content.style.setProperty('--ty', '0px');
      });
    }

    function updateCardFx(event) {
      const active = container.querySelector('.glass-card[data-pos="1"]');
      if (!active) return;
      const rect = active.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) {
        return;
      }

      const x = (event.clientX - rect.left) / rect.width;
      const y = (event.clientY - rect.top) / rect.height;
      active.style.setProperty('--mx', `${Math.round(x * 100)}%`);
      active.style.setProperty('--my', `${Math.round(y * 100)}%`);

      const content = active.querySelector('.card-content');
      if (!content) return;
      const tx = (x - 0.5) * 6;
      const ty = (y - 0.5) * 6;
      content.style.setProperty('--tx', `${tx.toFixed(2)}px`);
      content.style.setProperty('--ty', `${ty.toFixed(2)}px`);
    }

    container.addEventListener('mouseenter', stop);
    container.addEventListener('mouseleave', start);
    container.addEventListener('focusin', stop);
    container.addEventListener('focusout', start);
    container.addEventListener('pointermove', updateCardFx);
    container.addEventListener('pointerleave', resetCardFx);

    resetCardFx();
    start();
  })();
</script>
