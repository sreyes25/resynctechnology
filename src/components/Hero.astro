  .hud-trend-dot.d5{ animation-delay: 640ms; }
  .hud-trend-dot.d6{ animation-delay: 800ms; }

  @keyframes hudTravel{
    0%{ left: -10px; opacity: 0; }
    18%{ opacity: 1; }
    82%{ opacity: 1; }
