---
const faqs = [
  {
    q: "How much does custom software development cost in NYC?",
    a: "Pricing depends on scope, integrations, and delivery timeline. Most projects are phased so you can launch core workflows first and expand in measured milestones.",
  },
  {
    q: "Can I hire a software developer in Brooklyn for websites and apps?",
    a: "Yes. We build websites, apps, and custom software for Brooklyn and NYC businesses that need fast execution with clean engineering standards.",
  },
  {
    q: "Do you offer business automation and API integration in NYC?",
    a: "Yes. We build workflow automation, CRM automation, and API integrations to reduce repetitive work and improve operational speed.",
  },
];
---

<section class="border-t border-black/5 bg-paper">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <h2 class="text-3xl font-semibold tracking-tight text-slateink md:text-4xl">NYC Software FAQs</h2>
    <div class="mt-8 grid gap-4">
      {faqs.map((item) => (
        <details class="rounded-xl2 border border-black/10 bg-white p-5 shadow-soft">
          <summary class="cursor-pointer text-base font-semibold text-slateink">{item.q}</summary>
          <p class="mt-3 text-sm leading-relaxed text-ink/70 sm:text-base">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
