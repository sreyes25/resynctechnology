---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NYCServiceCluster from "../../components/NYCServiceCluster.astro";

const serviceCategories = [
  {
    title: "Web Development",
    desc: "High-converting websites with strong UX, fast performance, and clean CMS workflows.",
    href: "/start",
  },
  {
    title: "MVP Websites",
    desc: "Launch quickly with focused scope, validate demand, and scale with a stable foundation.",
    href: "/start",
  },
  {
    title: "eCommerce Development",
    desc: "Shopify, WooCommerce, and custom storefronts designed for conversion and retention.",
    href: "/start",
  },
];

const capabilities = {
  frontend: ["Astro", "React", "Next.js", "Vue", "Tailwind CSS"],
  backend: ["Node.js", "Laravel", "Supabase", "Firebase", "Postgres"],
  cms: ["WordPress", "Shopify", "Webflow", "Sanity", "Contentful"],
  devops: ["Vercel", "Netlify", "AWS", "Cloudflare", "Docker"],
};

const pillClass = (name: string) => {
  const key = name.toLowerCase();
  if (key.includes("react")) return "tech-react";
  if (key.includes("next")) return "tech-next";
  if (key.includes("vue")) return "tech-vue";
  if (key.includes("tailwind")) return "tech-tailwind";
  if (key.includes("astro")) return "tech-astro";
  if (key.includes("node")) return "tech-node";
  if (key.includes("laravel")) return "tech-laravel";
  if (key.includes("supabase")) return "tech-supabase";
  if (key.includes("firebase")) return "tech-firebase";
  if (key.includes("postgres")) return "tech-postgres";
  if (key.includes("wordpress")) return "tech-wordpress";
  if (key.includes("shopify")) return "tech-shopify";
  if (key.includes("webflow")) return "tech-webflow";
  if (key.includes("sanity")) return "tech-sanity";
  if (key.includes("contentful")) return "tech-contentful";
  if (key.includes("vercel")) return "tech-vercel";
  if (key.includes("netlify")) return "tech-netlify";
  if (key.includes("aws")) return "tech-aws";
  if (key.includes("cloudflare")) return "tech-cloudflare";
  if (key.includes("docker")) return "tech-docker";
  return "tech-generic";
};

const industries = [
  { title: "Education & HR", desc: "Recruitment sites, training portals, and internal tools." },
  { title: "Healthcare", desc: "Patient-first UX, HIPAA-aware workflows, and secure data handling." },
  { title: "Real Estate", desc: "Listings, lead capture, and CRM-ready integrations." },
  { title: "Professional Services", desc: "Authority positioning for agencies, firms, and consultants." },
  { title: "Retail & eCommerce", desc: "Conversion-first storefronts with retention focus." },
  { title: "Construction & Trades", desc: "Local search visibility with clear quote funnels." },
];

const featuredSites = [
  {
    name: "Park Slope Dermatology",
    url: "https://parkslopedermatology.com/",
    label: "Healthcare",
    summary: "WordPress foundation with custom design, bespoke components, and automation workflows tailored to patient intake.",
    tags: ["WordPress", "Custom design", "Automation"],
    bg: "#acffac66",
  },
  {
    name: "Infiniker",
    url: "https://infiniker.com/",
    label: "Home Services",
    summary: "Fully custom site built from scratch with a clean structure and conversion-focused layout.",
    tags: ["Custom build", "Performance", "Conversion UX"],
    bg: "#4bb8ff59",
  },
];

const testimonials = [
  {
    quote:
      "Resync delivered a clean, modern site that immediately improved our lead quality. The process was fast and transparent.",
    name: "Alicia M.",
    role: "Marketing Lead",
    company: "HealthSpan",
  },
  {
    quote:
      "We launched our new Shopify store in weeks and conversions jumped. The team thought about UX and performance end-to-end.",
    name: "Drew K.",
    role: "Founder",
    company: "Northway Goods",
  },
  {
    quote:
      "Clear roadmap, tight execution, and the site looks incredible. Exactly what we needed to go to market.",
    name: "Priya S.",
    role: "CEO",
    company: "Civic Analytics",
  },
];
---

<BaseLayout
  title="NYC Website Development Services | Brooklyn Web Design & SEO | Resync"
  description="Custom website development in NYC and Brooklyn. We build high-performance business websites with technical SEO, conversion UX, and modern web stacks."
  keywords={[
    "web development nyc",
    "website development nyc",
    "software development company nyc",
    "custom software nyc",
    "websites nyc",
    "website development brooklyn",
    "nyc web design company",
    "seo website development",
    "custom website developer nyc",
  ]}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Website Development",
    provider: {
      "@type": "SoftwareCompany",
      name: "Resync Technology LLC",
    },
    areaServed: ["New York City", "Brooklyn"],
    description: "Custom website development for NYC and Brooklyn businesses.",
  }}
>
  <section class="relative overflow-hidden bg-[#05060f] text-slate-100">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-24 top-0 h-72 w-72 rounded-full bg-resync-600/25 blur-3xl"></div>
      <div class="absolute right-0 top-10 h-80 w-80 rounded-full bg-[#0d172a] blur-[120px]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.06),transparent_30%),radial-gradient(circle_at_80%_0%,rgba(225,29,72,0.08),transparent_28%),radial-gradient(circle_at_50%_70%,rgba(255,255,255,0.05),transparent_38%)]"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 pt-5 pb-16 md:pb-24 rt-hero-top">
      <p class="hero-eyebrow">Website development</p>

      <div class="mt-4 grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl">
            Websites built to convert, scale, and stay fast.
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-200/90">
            We design and build custom websites that match your goals and budget—WordPress, Shopify, and modern web stacks.
            Whether it’s a commercial site, a lead-gen engine, or an eCommerce storefront, we build for performance and ROI.
          </p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/start" class="rt-btn-primary">
              Start a Project
              <span class="cta-glow" aria-hidden="true"></span>
            </a>
            <a href="/#services" class="cta-secondary">View All Services</a>
          </div>

          <div class="mt-8 grid gap-3 text-sm text-slate-200/85 sm:grid-cols-2">
            {[
              "Custom builds + redesigns",
              "WordPress, Shopify, Webflow",
              "SEO-ready architecture",
              "Conversion-focused UX",
            ].map((item) => (
              <div class="flex items-center gap-2">
                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/10 text-xs text-white/90">→</span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="relative">
          <div class="absolute -top-6 right-4 h-24 w-24 rounded-full bg-gradient-to-br from-[#ff7a59] to-[#f43f5e] opacity-70 blur-2xl"></div>
          <div class="absolute -bottom-8 left-6 h-28 w-28 rounded-full bg-gradient-to-br from-[#38bdf8] to-[#6366f1] opacity-60 blur-2xl"></div>

          <div class="relative rounded-3xl border border-white/10 bg-gradient-to-br from-white/10 via-white/5 to-white/0 p-4 shadow-[0_25px_70px_rgba(0,0,0,0.45)]">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center justify-between text-xs text-white/60">
                <span class="font-semibold text-white/80">Site Performance</span>
                <span>Last 30 days</span>
              </div>
              <div class="mt-4 grid gap-3 sm:grid-cols-3">
                {[
                  { label: "Page speed", value: "96/100", delta: "↑" },
                  { label: "Leads", value: "+34%", delta: "↑" },
                  { label: "Bounce", value: "-22%", delta: "↓" },
                ].map((stat) => (
                  <div class="rounded-xl border border-white/10 bg-white/5 p-3">
                    <div class="text-xs text-white/60">{stat.label}</div>
                    <div class="mt-2 text-lg font-semibold text-white">{stat.value}</div>
                    <div class="mt-1 text-xs text-emerald-300/90">{stat.delta}</div>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <div class="text-xs text-white/60">UX Focus</div>
                <div class="mt-3 space-y-2 text-sm text-white/80">
                  <div class="flex items-center justify-between">
                    <span>Landing pages</span>
                    <span class="text-white/60">Optimized</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span>Navigation</span>
                    <span class="text-white/60">Clear</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span>Forms</span>
                    <span class="text-white/60">High intent</span>
                  </div>
                </div>
              </div>

              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <div class="text-xs text-white/60">Build Stack</div>
                <div class="mt-3 space-y-2 text-sm text-white/80">
                  <div class="flex items-center justify-between">
                    <span>WordPress</span>
                    <span class="text-white/60">CMS</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span>Shopify</span>
                    <span class="text-white/60">Commerce</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span>Astro</span>
                    <span class="text-white/60">Frontend</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ws-section ws-mid ws-pop accent-purple">
    <div class="section-wash"></div>
    <div class="section-content mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="max-w-2xl">
        <h2 class="section-title text-3xl font-bold text-slateink">Core website services</h2>
        <p class="mt-3 text-slate-700">
          Custom digital solutions built to streamline operations, increase visibility, and drive growth.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {serviceCategories.map((service) => (
          <div class="accent-card service-card rounded-xl2 border border-black/5 p-6 shadow-soft">
            <div class="service-card-top">
              <span class="service-chip">Core</span>
            </div>
            <h3 class="text-lg font-semibold text-slateink">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{service.desc}</p>
            <a href={service.href} class="mt-4 inline-flex items-center text-sm font-semibold text-resync-700">
              Learn more
              <span aria-hidden="true" class="ml-2">›</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ws-section ws-mid accent-blue relative overflow-hidden text-slateink">
    <div class="section-wash"></div>
    <div class="section-content mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="max-w-2xl">
        <h2 class="section-title text-3xl font-bold text-slateink">Featured websites</h2>
        <p class="mt-3 text-slate-700">
          A quick look at recent builds. Tap in to view the live experience.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {featuredSites.map((site, idx) => (
          <div
            class={`accent-card accent-split ${idx % 2 === 0 ? "accent-purple" : "accent-blue"} group overflow-hidden rounded-2xl border shadow-soft`}
            style={site.bg ? `--card-bg: ${site.bg};` : undefined}
          >
            <div class="border-b border-black/5 bg-white/70 px-4 py-3">
              <span class="accent-strap">{site.label}</span>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <h3 class="text-xl font-semibold text-slateink">{site.name}</h3>
                  <p class="mt-2 text-sm text-slate-600">{site.summary}</p>
                </div>
                <a
                  href={site.url}
                  class="visit-site-btn hidden shrink-0 rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition sm:inline-flex"
                  target="_blank"
                  rel="noreferrer"
                >
                  Visit site
                </a>
              </div>

              <div class="preview-frame mt-5 overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
                <div class="flex items-center justify-between border-b border-slate-200 bg-white px-3 py-2 text-[11px] text-slate-400">
                  <span class="font-semibold text-slate-500">Live preview</span>
                  <span class="truncate">{site.url}</span>
                </div>
                <div class="preview-frame relative h-72 bg-slate-50 md:h-80 lg:h-[22rem]" data-preview>
                  <div class="preview-canvas">
                    <iframe
                      src={site.url}
                      class="preview-iframe"
                      loading="lazy"
                      title={`${site.name} preview`}
                    ></iframe>
                  </div>
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-white/70 via-transparent to-transparent"></div>
                  <div class="absolute bottom-3 left-3 flex flex-wrap gap-2">
                    <a
                      href={site.url}
                      class="visit-site-btn pointer-events-auto rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 shadow-soft transition"
                      target="_blank"
                      rel="noreferrer"
                    >
                      Open live site
                    </a>
                  </div>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500">
                {site.tags?.map((tag) => (
                  <span class="tag-pill rounded-full border border-slate-200 bg-slate-50 px-3 py-1">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ws-section ws-mid accent-purple relative overflow-hidden text-slateink">
    <div class="section-wash"></div>
    <div class="section-content ws-wrap">
      <div class="ws-container">
        <h2 class="section-title">Contract-ready delivery stack</h2>
        <p class="section-body">
          We’re a contracted web partner built for outcomes, not busywork. You get a focused team that can
          scope fast, execute cleanly, and hand off with confidence—whether it’s a full rebuild or a targeted sprint.
        </p>
        <p class="section-body">
          Strategy, design, development, and analytics stay aligned so every launch supports growth, not just aesthetics.
        </p>
      </div>

      <div class="ws-grid-2">
        <div class="accent-card rounded-2xl border border-black/5 bg-white p-6 shadow-soft accent-purple">
          <h3 class="text-base font-semibold">Frontend</h3>
          <div class="ws-pill-row">
            {capabilities.frontend.map((item) => (
              <span class={`tech-pill ${pillClass(item)}`}>{item}</span>
            ))}
          </div>
        </div>
        <div class="accent-card rounded-2xl border border-black/5 bg-white p-6 shadow-soft accent-blue">
          <h3 class="text-base font-semibold text-slateink">Backend</h3>
          <div class="ws-pill-row">
            {capabilities.backend.map((item) => (
              <span class={`tech-pill ${pillClass(item)}`}>{item}</span>
            ))}
          </div>
        </div>
        <div class="accent-card rounded-2xl border border-black/5 bg-white p-6 shadow-soft accent-green">
          <h3 class="text-base font-semibold text-slateink">CMS + Commerce</h3>
          <div class="ws-pill-row">
            {capabilities.cms.map((item) => (
              <span class={`tech-pill ${pillClass(item)}`}>{item}</span>
            ))}
          </div>
        </div>
        <div class="accent-card rounded-2xl border border-black/5 bg-white p-6 shadow-soft accent-red">
          <h3 class="text-base font-semibold text-slateink">Cloud + DevOps</h3>
          <div class="ws-pill-row">
            {capabilities.devops.map((item) => (
              <span class={`tech-pill ${pillClass(item)}`}>{item}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ws-section ws-mid accent-blue">
    <div class="section-wash"></div>
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold text-slateink">Industries served</h2>
        <p class="mt-3 text-slate-700">
          We adapt the build to your business model and customer journey.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-2xl border border-white/40 bg-white/85 p-6 shadow-[0_18px_50px_rgba(15,23,42,0.12),0_24px_60px_rgba(75,184,255,0.18)] backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-400">Where we deliver</p>
          <h3 class="mt-3 text-2xl font-semibold text-slateink">Vertical expertise with modern UX</h3>
          <p class="mt-3 text-sm text-slate-600">
            We build for industries that need trust, clarity, and conversion—so the site looks sharp and performs under
            real-world customer behavior.
          </p>
          <div class="mt-5 flex flex-wrap gap-2 text-xs">
            <span class="rounded-full border border-blue-200/70 bg-blue-50/80 px-3 py-1 text-slate-700">Lead-gen funnels</span>
            <span class="rounded-full border border-blue-200/70 bg-blue-50/80 px-3 py-1 text-slate-700">Booking workflows</span>
            <span class="rounded-full border border-blue-200/70 bg-blue-50/80 px-3 py-1 text-slate-700">eCommerce UX</span>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {industries.map((industry) => (
            <div class="rounded-2xl border border-white/40 bg-white/85 p-5 shadow-[0_14px_34px_rgba(15,23,42,0.12)] backdrop-blur">
              <h4 class="text-base font-semibold text-slateink">{industry.title}</h4>
              <p class="mt-2 text-sm text-slate-600">{industry.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <script is:inline>
    (() => {
      const BASE_W = 1440;
      const BASE_H = 900;
      const update = () => {
        document.querySelectorAll("[data-preview]").forEach((el) => {
          const w = el.clientWidth;
          const h = el.clientHeight;
          if (!w || !h) return;
          const scale = Math.min(w / BASE_W, h / BASE_H);
          el.style.setProperty("--preview-scale", scale.toFixed(4));
        });
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", update, { once: true });
      } else {
        update();
      }
      window.addEventListener("resize", () => requestAnimationFrame(update));
    })();
  </script>

  <section class="ws-section ws-mid accent-purple relative overflow-hidden text-slateink">
    <div class="section-wash"></div>
    <div class="section-content mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="max-w-2xl">
        <h2 class="section-title text-3xl font-bold text-slateink">Testimonials</h2>
        <p class="mt-3 text-slate-700">
          Long-term partnerships built on results and clear delivery.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {testimonials.map((item) => (
          <div class="accent-card rounded-xl2 border border-black/5 p-6 shadow-soft">
            <div class="flex gap-1 text-amber-400">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <p class="mt-4 text-sm text-slate-600">“{item.quote}”</p>
            <div class="mt-4 text-sm font-semibold text-slateink">{item.name}</div>
            <div class="text-xs text-slate-500">{item.role} · {item.company}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ws-section ws-mid accent-red relative overflow-hidden text-slateink">
    <div class="section-wash"></div>
    <div class="section-content mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="accent-card rounded-xl2 border border-black/5 p-10 shadow-soft">
        <h2 class="section-title text-3xl font-bold text-slateink">Ready to start in the next 30–90 days?</h2>
        <p class="mt-3 text-slate-700">
          Tell us what you need and we’ll map a plan that aligns with your budget, timeline, and growth goals.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/start" class="rt-btn-primary-light">
            Talk to an Expert
          </a>
          <a href="/#work" class="cta-secondary">View Work</a>
        </div>
      </div>
    </div>
  </section>
  <NYCServiceCluster />
</BaseLayout>
