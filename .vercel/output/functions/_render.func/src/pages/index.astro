---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import WhyResync from "../components/WhyResync.astro";
import Work from "../components/Work.astro";
import CTA from "../components/CTA.astro";
import SeoFaq from "../components/SeoFaq.astro";
import NYCServiceCluster from "../components/NYCServiceCluster.astro";

const title = "Software Development Company NYC | Custom Software, Web, App & Automation";
const description =
  "Resync Technology is a NYC software development company building custom software, web development, app development, business automation, and digital marketing systems.";
const keywords = [
  "software development company nyc",
  "software development nyc",
  "brooklyn software studio",
  "NYC custom software",
  "custom software nyc",
  "web development nyc",
  "websites nyc",
  "app development nyc",
  "business automation nyc",
  "hire developer nyc",
  "digital marketing nyc",
  "workflow automation nyc",
  "api integration nyc",
  "startup mvp development nyc",
  "saas development nyc",
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How much does custom software development cost in NYC?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Most custom software projects in NYC start around the mid four-figure range for focused MVPs and scale based on integrations, workflow complexity, and timeline requirements.",
        },
      },
      {
        "@type": "Question",
        name: "What is the cost to hire a software development company in NYC?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Cost depends on scope, speed, and technical depth. Teams usually budget by milestone so product discovery, build, and optimization phases are clear and measurable.",
        },
      },
      {
        "@type": "Question",
        name: "How much does business automation cost in NYC?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Automation pricing varies with system count and API complexity. CRM and workflow automations are often delivered in phased sprints to create ROI quickly.",
        },
      },
      {
        "@type": "Question",
        name: "How long does startup MVP development take in NYC?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Most startup MVPs can launch in weeks with focused scope, clear decision cycles, and a technical roadmap for post-launch scaling.",
        },
      },
    ],
  }}
>
  <Hero />
  <Services />
  <NYCServiceCluster />
  <Process />
  <WhyResync />
  <Work />
  <SeoFaq />
  <CTA />
</BaseLayout>
