{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/intake/?$",
			"dest": "_render"
		},
		{
			"src": "^/invoiceamericano/paymentsuccess/?$",
			"dest": "_render"
		},
		{
			"src": "^/invoiceamericano/?$",
			"dest": "_render"
		},
		{
			"src": "^/robots\\.txt/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/brooklyn-software-developer/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/business-automation-nyc/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/digital-marketing/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/digital-marketing-nyc/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/nyc-custom-software-development/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/startup-mvp-development-nyc/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/websites/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/start/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}